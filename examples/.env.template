# @ryan.blunden/discord-sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: DISCORD_
#
# Security environment variables:
DISCORD_BOT_TOKEN=your_bottoken_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
DISCORD_DEBUG=true
